# =====================================================================
# ReviewFlow SaaS - Production Environment Configuration
# =====================================================================

# Environment (development | testing | production)
ENVIRONMENT=production
PROJECT_NAME="ReviewFlow SaaS"
API_V1_STR="/api/v1"

# JWT Security (Must be a strong random 32+ character key in production)
SECRET_KEY="generate_a_random_32_character_hex_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (PostgreSQL recommended for production)
DATABASE_URL="postgresql://reviewflow:change_me_in_production@postgres:5432/reviewflow_db"

# Telegram MTProto Credentials (Obtain from https://my.telegram.org)
TELEGRAM_API_ID=00000000
TELEGRAM_API_HASH="your_telegram_api_hash_here"
TELEGRAM_STRING_SESSION="your_telethon_string_session_here"
SESSION_PATH="sessions/multi_tenant_userbot"

# Redis Queue & Caching
REDIS_URL="redis://redis:6379/0"

# Central Verified Reviews Repository Channel ID (Must be negative integer string for Telegram channels)
DEFAULT_REVIEW_BANK_ID="-1000000000000"
DEFAULT_REVIEW_BANK_TITLE="Review Bank"

# CORS Allowed Origins (Comma-separated list of allowed web origins)
CORS_ORIGINS="http://localhost:3000,https://app.yourdomain.com"
